<style>
  :root {
    --ig: #50C878;
    --ig-dark: #3DA35F;
    --ig-light: #E8F5EE;
    --ig-surface: #F7F8F5;
    --ig-ink: #1A1A1A;
    --ig-ink-2: #6B7B6E;
    --ig-ink-3: #A8B5AC;
    --font-editorial: 'Playfair Display', serif;
    --font-display: 'Space Grotesk', sans-serif;
    --font-body: 'DM Sans', sans-serif;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--font-body);
    color: var(--ig-ink);
    background: var(--ig-surface);
    overflow-x: hidden;
  }

  /* Navigation */
  nav {
    position: fixed;
    top:0; left:0; right:0;
    z-index: 1000;
    padding: 24px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.4s ease, backdrop-filter 0.4s ease;
  }
  nav.scrolled {
    background: rgba(247,249,248,0.92);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border-bottom: 1px solid rgba(80,200,120,0.08);
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 1.5px;
    color: var(--ig);
    text-decoration: none;
  }
  .nav-logo img {
    height: 48px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ig-ink-2);
    position: relative;
    padding-bottom: 4px;
    transition: color 0.3s ease;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom:0; left:0;
    width: 0; height: 1.5px;
    background: var(--ig);
    transition: width 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .nav-links a:hover { color: var(--ig); }
  .nav-links a:hover::after { width: 100%; }

  /* Hero */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--ig-surface);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: left;
    max-width: 1100px;
    padding: 0 48px;
  }

  .hero-title {
    font-family: var(--font-editorial);
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ig-ink);
    margin-bottom: 24px;
  }
  .hero-title .line {
    display: inline;
  }
  .hero-title .line-inner {
    display: inline;
    transform: translateY(110%);
  }
  @media (max-width: 600px) {
    .hero-title {
      font-size: clamp(28px, 10vw, 48px);
      line-height: 1.1;
    }
  }
  .hero-sub {
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 400;
    color: var(--ig-ink-2);
    max-width: 560px;
    margin: 0 0 40px 0;
    line-height: 1.6;
    opacity: 0;
    transform: translateY(20px);
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 48px;
    background: var(--ig);
    color: #fff;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 0;
    transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
    opacity: 0;
    transform: translateY(20px);
    border: 1.5px solid var(--ig);
    margin-bottom: 32px;
  }
  .hero-cta:hover {
    background: transparent;
    color: var(--ig);
    transform: translateY(-2px);
  }

  /* Section base */
  section {
    position: relative;
    padding: 160px 48px;
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ig);
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .section-label::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--ig);
  }
  .section-title {
    font-family: var(--font-editorial);
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 700px;
    margin-bottom: 24px;
    text-align: center;
  }
  .section-text {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ig-ink-2);
    max-width: 540px;
    text-align: center;
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .about-text .section-title,
  .about-text .section-text,
  .about-text .section-label {
    text-align: left;
    justify-content: flex-start;
  }
  .about-images {
    position: relative;
    height: 520px;
  }
  .about-img {
    position: absolute;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(26,26,26,0.14);
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .about-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .about-img-1 {
    width: 68%; height: 72%;
    top: 0; left: 0;
    z-index: 2;
  }
  .about-img-2 {
    width: 52%; height: 52%;
    bottom: 0; right: 0;
    z-index: 3;
    border: 4px solid var(--ig-surface);
  }
  .about-img-3 {
    width: 42%; height: 42%;
    top: 18%; right: 2%;
    z-index: 1;
    opacity: 0.55;
    filter: blur(1px);
  }
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 80px;
  }
  .stat-card {
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(80,200,120,0.08);
    border-radius: 2px;
    padding: 40px 32px;
    text-align: center;
    backdrop-filter: blur(12px);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    contain: layout;
  }
  .stat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(80,200,120,0.08);
  }
  .stat-number {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    color: var(--ig);
    line-height: 1;
    margin-bottom: 12px;
    font-variant-numeric: tabular-nums;
    min-width: 1ch;
  }
  .stat-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--ig-ink-2);
    letter-spacing: 0.02em;
  }

  /* Services */
  .services {
    background: var(--ig-ink);
    color: #fff;
    border-radius: 0;
    margin: 0;
    overflow: hidden;
    position: relative;
  }
  .services::before {
    content: '';
    position: absolute;
    top: -50%; right: -20%;
    width: 80%; height: 120%;
    background: radial-gradient(ellipse, rgba(80,200,120,0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .services .section-label { color: var(--ig-light); }
  .services .section-label::before { background: var(--ig-light); }
  .services .section-title { color: #fff; max-width: 500px;
    text-align: center;
  }
  .services .section-text { color: rgba(255,255,255,0.7);
    text-align: center;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 64px;
  }
  .service-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 2px;
    padding: 40px 32px;
    backdrop-filter: blur(20px);
    transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
    position: relative;
    overflow: hidden;
  }
  .service-card::before {
    content: '';
    position: absolute;
    top:0; left:0; right:0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
  }
  .service-card:hover {
    background: rgba(255,255,255,0.08);
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.15);
  }
  .service-icon {
    width: 48px; height: 48px;
    border-radius: 2px;
    background: rgba(80,200,120,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    font-size: 20px;
  }
  .service-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
    color: #fff;
  }
  .service-desc {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255,255,255,0.6);
  }

  /* Properties */
  .properties-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }
  .properties-scroll {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    overflow-x: visible;
    padding: 0;
    scroll-snap-type: none;
  }
  .properties-scroll::-webkit-scrollbar { display: none; }
  .property-card {
    flex: none;
    background: #fff;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(26,26,26,0.06);
    scroll-snap-align: start;
    transition: transform 0.4s ease;
  }
  .property-card:nth-child(1) { grid-column: span 7; }
  .property-card:nth-child(2) { grid-column: span 5; }
  .property-card:nth-child(3) { grid-column: span 5; }
  .property-card:nth-child(4) { grid-column: span 7; }
  .property-card:nth-child(1) .property-img { height: 380px; }
  .property-card:nth-child(2) .property-img { height: 280px; }
  .property-card:nth-child(3) .property-img { height: 280px; }
  .property-card:nth-child(4) .property-img { height: 320px; }
  .property-card:hover { transform: translateY(-6px); }
  .property-img {
    height: 240px;
    background: linear-gradient(135deg, var(--ig-light), var(--ig-surface));
    position: relative;
    overflow: hidden;
  }
  .property-img::after {
    content: '';
    position: absolute;
    inset:0;
    background: linear-gradient(to top, rgba(26,26,26,0.4), transparent 50%);
  }
  .property-badge {
    position: absolute;
    top: 16px; left: 16px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(8px);
    padding: 6px 14px;
    border-radius: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ig);
    z-index: 2;
  }
  .property-info { padding: 24px; }
  .property-name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .property-loc {
    font-size: 13px;
    color: var(--ig-ink-3);
    margin-bottom: 16px;
  }
  .property-price {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--ig);
  }

  /* Testimonial */
  .testimonial {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }
  .testimonial-quote {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ig-ink);
    margin-bottom: 40px;
    position: relative;
  }
  .testimonial-quote::before {
    content: '“';
    font-size: 120px;
    line-height: 1;
    color: var(--ig-light);
    position: absolute;
    top: -40px; left: -20px;
    font-family: serif;
    z-index: -1;
  }
  .testimonial-avatar {
    width: 56px; height: 56px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--ig-light), var(--ig));
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    font-size: 20px;
  }
  .testimonial-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }
  .testimonial-role {
    font-size: 13px;
    color: var(--ig-ink-3);
  }

  /* CTA */
  .cta-section {
    background: linear-gradient(135deg, var(--ig) 0%, var(--ig-dark) 100%);
    border-radius: 0;
    margin: 0;
    padding: 140px 48px;
    text-align: center;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .cta-section::before {
    content: '';
    position: absolute;
    top: -20%; left: -10%;
    width: 50%; height: 80%;
    background: radial-gradient(ellipse, rgba(255,255,255,0.1) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-section::after {
    content: '';
    position: absolute;
    bottom: -30%; right: -10%;
    width: 60%; height: 100%;
    background: radial-gradient(ellipse, rgba(212,234,234,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-title {
    font-family: var(--font-editorial);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    margin-bottom: 20px;
    position: relative;
    z-index: 2;
  }
  .cta-text {
    font-size: 17px;
    opacity: 0.85;
    max-width: 480px;
    margin: 0 auto 40px;
    position: relative;
    z-index: 2;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 40px;
    background: #fff;
    color: var(--ig);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 0;
    transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
    position: relative;
    z-index: 2;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.15);
  }

  /* Footer */
  footer {
    border-top: 1px solid var(--ig-light);
    padding: 64px 48px 32px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-col-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--ig-ink);
    margin-bottom: 4px;
  }
  .footer-col a {
    font-size: 14px;
    color: var(--ig-ink-2);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-col a:hover { color: var(--ig); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--ig-light);
  }
  .footer-socials {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }
  .footer-socials a {
    width: 36px;
    height: 36px;
    border-radius: 0;
    background: var(--ig-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ig);
    transition: all 0.3s ease;
  }
  .footer-socials a:hover {
    background: var(--ig);
    color: #fff;
    transform: translateY(-2px);
  }
  .footer-socials svg {
    width: 18px;
    height: 18px;
  }
  .footer-copy {
    font-size: 13px;
    color: var(--ig-ink-3);
  }
  .footer-legal {
    display: flex;
    gap: 24px;
  }
  .footer-legal a {
    font-size: 13px;
    color: var(--ig-ink-3);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-legal a:hover { color: var(--ig); }
  .footer-links {
    display: flex;
    gap: 24px;
    list-style: none;
  }
  .footer-links a {
    font-size: 13px;
    color: var(--ig-ink-2);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-links a:hover { color: var(--ig); }

  /* Contact form */
  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
    max-width: 600px;
  }
  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    padding: 14px 18px;
    border: 1px solid rgba(80,200,120,0.15);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 15px;
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
    width: 100%;
  }
  .contact-form input:focus,
  .contact-form textarea:focus,
  .contact-form select:focus {
    outline: none;
    border-color: var(--ig);
    box-shadow: 0 0 0 4px rgba(80,200,120,0.08);
  }
  .contact-form textarea {
    grid-column: 1 / -1;
    min-height: 120px;
    resize: vertical;
  }
  .contact-form button {
    grid-column: 1 / -1;
    padding: 16px 36px;
    background: var(--ig);
    color: #fff;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .contact-form button:hover {
    background: var(--ig-dark);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(80,200,120,0.2);
  }
  .contact-section {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .contact-section .section-text {
    margin: 0 auto 32px;
    text-align: center;
  }

  /* Mobile Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
