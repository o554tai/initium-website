    // Phase 2: Settle to natural brightness
    .to('.hero-logo-png', { filter: 'brightness(1) blur(0px)', duration: 0.6, ease: 'power1.out' })
    // Phase 3: Ambient living pulse
    .to('.hero-logo-png', {
      scale: 1.015,
      filter: 'brightness(1.04) drop-shadow(0 0 14px rgba(80,200,120,0.18))',
      duration: 2.2,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1
    })

    // Text reveals — 3D character stagger
    .fromTo('.line-inner', {
      y: '110%',
      rotateX: -75,
      opacity: 0
    }, {
      y: '0%',
      rotateX: 0,
      opacity: 1,
      duration: 1.0,
      stagger: 0.08,
      ease: 'power4.out'
    }, 0.9)
    .fromTo('.hero-sub', {
      y: 40,
      rotateX: 20,
      opacity: 0
    }, {
      y: 0,
      rotateX: 0,
      opacity: 1,
      duration: 0.8,
      ease: 'power3.out'
    }, 1.2)
    .fromTo('.hero-cta', {
      y: 30,
      rotateX: 15,
      opacity: 0
    }, {
      y: 0,
      rotateX: 0,
      opacity: 1,
      duration: 0.7,
      ease: 'power3.out'
    }, 1.5);

  // Nav scroll
  ScrollTrigger.create({
    start: 'top -80',
    onUpdate: (self) => {
      document.getElementById('navbar').classList.toggle('scrolled', self.progress > 0);
    }
  });

  // About parallax with subtle 3D rotation
  gsap.to('.about-img-1', {
    y: -60,
    rotateZ: -2,
    scrollTrigger: { trigger: '#about', start: 'top bottom', end: 'bottom top', scrub: 1 }
  });
  gsap.to('.about-img-2', {
    y: -100,
    rotateZ: 1.5,
    scrollTrigger: { trigger: '#about', start: 'top bottom', end: 'bottom top', scrub: 1.5 }
  });
  gsap.to('.about-img-3', {
    y: -30,
    rotateZ: -1,
    scrollTrigger: { trigger: '#about', start: 'top bottom', end: 'bottom top', scrub: 0.8 }
  });

  // Stats counter with 3D roll
  document.querySelectorAll('.stat-number').forEach(stat => {
    const target = parseInt(stat.dataset.target);
    const suffix = stat.dataset.suffix || '';
    const obj = { val: 0 };
    gsap.fromTo(stat, {
      rotateX: 90,
      opacity: 0
    }, {
      rotateX: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: stat, start: 'top 85%', toggleActions: 'play none none none' }
    });
    gsap.to(obj, {
      val: target,
      duration: 2,
      snap: { val: 1 },
      ease: 'power2.out',
      scrollTrigger: { trigger: stat, start: 'top 85%', toggleActions: 'play none none none' },
      onUpdate: () => { stat.textContent = Math.round(obj.val) + suffix; }
    });
  });

  // Service cards — 3D staggered rise
  gsap.fromTo('.service-card', {
    y: 80,
    rotateX: 25,
    opacity: 0
  }, {
    y: 0,
    rotateX: 0,
    opacity: 1,
    duration: 0.9,
    stagger: 0.12,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.service-grid', start: 'top 85%', toggleActions: 'play none none none' }
  });

  // Property cards — 3D slide in
  gsap.fromTo('.property-card', {
    x: 80,
    rotateY: -15,
    opacity: 0
  }, {
    x: 0,
    rotateY: 0,
    opacity: 1,
    duration: 0.9,
    stagger: 0.1,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.properties-scroll', start: 'top 85%', toggleActions: 'play none none none' }
  });

  // Testimonial — 3D depth fade
  gsap.fromTo('.testimonial-card', {
    y: 50,
    rotateX: 15,
    opacity: 0
  }, {
    y: 0,
    rotateX: 0,
    opacity: 1,
    duration: 1,
    stagger: 0.15,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.testimonials-grid', start: 'top 80%', toggleActions: 'play none none none' }
  });

  // CTA — 3D perspective stagger
  gsap.fromTo('.cta-section .section-inner > *', {
    y: 50,
    rotateX: 18,
    opacity: 0
  }, {
    y: 0,
    rotateX: 0,
    opacity: 1,
    duration: 0.9,
    stagger: 0.15,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.cta-section', start: 'top 75%', toggleActions: 'play none none none' }
  });

  // Section reveals — 3D for titles and text
  document.querySelectorAll('.section-title, .section-text').forEach((el, i) => {
    gsap.fromTo(el, {
      y: 40,
      rotateX: 12,
      opacity: 0
    }, {
      y: 0,
      rotateX: 0,
      opacity: 1,
      duration: 1,
      delay: (i % 3) * 0.1,
      ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' }
    });
  });

  // Mobile menu toggle
  const navToggle = document.querySelector('.nav-toggle');
  const navLinks = document.querySelector('.nav-links');
  if (navToggle && navLinks) {
    navToggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('open');
      navToggle.classList.toggle('active');
      navToggle.setAttribute('aria-expanded', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('open');
        navToggle.classList.remove('active');
        navToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navLinks.classList.contains('open')) {
        navLinks.classList.remove('open');
        navToggle.classList.remove('active');
        navToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    });
  }

  // Scroll Progress Bar
  const scrollProgress = document.getElementById('scrollProgress');
  if (scrollProgress) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      scrollProgress.style.width = progress + '%';
    }, { passive: true });
  }

  // Page Transition on link clicks
  const pageTransition = document.getElementById('pageTransition');
  document.querySelectorAll('a[href]').forEach(link => {
    const href = link.getAttribute('href');
    if (href && !href.startsWith('#') && !href.startsWith('http') && !href.startsWith('mailto') && !href.startsWith('tel')) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        if (pageTransition) pageTransition.classList.add('active');
        setTimeout(() => { window.location.href = href; }, 500);
      });
    }
  });

  // Sticky CTA Bar
  const stickyCta = document.getElementById('stickyCta');
  if (stickyCta) {
    let ctaShown = false;
    window.addEventListener('scroll', () => {
      if (window.scrollY > window.innerHeight * 0.8) {
        if (!ctaShown) { stickyCta.classList.add('visible'); ctaShown = true; }
      } else {
        if (ctaShown) { stickyCta.classList.remove('visible'); ctaShown = false; }
      }
    }, { passive: true });
  }

</script>



